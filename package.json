{
  "name": "bbcrawl",
  "version": "0.1.0",
  "description": "Client-side vulnerability crawler for bug bounty automation",
  "type": "module",
  "bin": {
    "bbcrawl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/hooks/hook.js dist/hooks/hook.js",
    "smoke": "node --import tsx test/smoke/run-all.ts",
    "test": "npm run build && npm run smoke"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "imapflow": "^1.3.2",
    "js-yaml": "^4.1.1",
    "otplib": "^13.4.0",
    "pino": "^9.5.0",
    "playwright": "^1.49.1",
    "source-map": "^0.7.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.9",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
